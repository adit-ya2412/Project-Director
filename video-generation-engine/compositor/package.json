{
  "name": "compositor",
  "version": "1.0.0",
  "private": true,
  "description": "Remotion layer producer for the kinetic-text system (see docs/plans/retention_fast_kinetic_text.md)",
  "scripts": {
    "fonts": "node -e \"const fs=require('fs'),p=require('path');const s=p.join('..','backend','vendor','fonts'),d='public';fs.mkdirSync(d,{recursive:true});for(const f of fs.readdirSync(s).filter(f=>f.endsWith('.ttf'))){fs.copyFileSync(p.join(s,f),p.join(d,f));console.log('copied',f)}\"",
    "studio": "npm run fonts && remotion studio",
    "render": "npm run fonts && remotion render"
  },
  "dependencies": {
    "@remotion/cli": "^4.0.522",
    "@remotion/renderer": "^4.0.522",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "remotion": "^4.0.522"
  }
}