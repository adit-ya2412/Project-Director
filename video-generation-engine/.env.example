# =============================================================================
# Video Generation Engine — environment template
# =============================================================================
# Copy to .env and fill in. .env is gitignored; this file is committed and must
# NEVER contain real values.
#
#     cp .env.example .env
#
# You do NOT need every key to start. With DRY_RUN=true the whole pipeline runs
# on fake providers and produces an MP4 with zero API keys configured.
# Keys are marked [M0] [M5] [M6] [M7] [M8] for the phase that first needs them
# (see docs/13_Implementation_Guide.md).
# =============================================================================


# -----------------------------------------------------------------------------
# Application
# -----------------------------------------------------------------------------
APP_ENV=local                     # local | staging | production
LOG_LEVEL=INFO                    # DEBUG | INFO | WARNING | ERROR
LOG_FORMAT=json                   # json | console

# Master kill switch for paid providers. When true, every paid provider is
# replaced by its deterministic fake. Costs nothing, needs no keys, still
# renders a real MP4. Leave this ON until you deliberately want to spend money.
DRY_RUN=true


# -----------------------------------------------------------------------------
# Database  [M2]
# -----------------------------------------------------------------------------
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=video_engine
POSTGRES_USER=video_engine
POSTGRES_PASSWORD=
# Overrides the individual settings above if set:
# DATABASE_URL=postgresql+asyncpg://video_engine:password@localhost:5432/video_engine


# -----------------------------------------------------------------------------
# Redis — cache, rate limiting, search-result memoisation  [M2]
# -----------------------------------------------------------------------------
REDIS_URL=redis://localhost:6379/0


# -----------------------------------------------------------------------------
# File storage  [M0]
# -----------------------------------------------------------------------------
# Local filesystem for v1; S3/GCS later. Layout is:
#   {STORAGE_ROOT}/{project_id}/{assets,clips,narration,music,renders}/
# Files are stored by content hash, never by provider-supplied filename.
STORAGE_ROOT=./storage
MAX_DOWNLOAD_BYTES=104857600      # 100 MB cap per downloaded asset
DRAFT_RETENTION_DAYS=7            # draft renders purged after N days; finals kept


# =============================================================================
# PROVIDERS
# =============================================================================
# Every provider sits behind an interface (ADR-003). Swapping one is a config
# change, not a code change.
# =============================================================================

# -----------------------------------------------------------------------------
# OpenAI — planning LLM  [M5]
# -----------------------------------------------------------------------------
# Drives all four planning agents (Director, Scene, Shot, Asset Planner).
# Planning only — image and video generation go through fal.ai below.
# Get a key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
# OPENAI_ORG_ID=

# Model used by the planning agents. Must support structured / JSON-schema
# output — the Timeline IR is validated against a Pydantic schema on every call.
# Left commented so app/core/config.py's defaults apply; uncomment to override.
# NOTE: an empty value here does NOT fall back to the default — it overrides it
# with an empty string. Comment the line out rather than blanking it.
# OPENAI_PLANNING_MODEL=
# Cheaper model for mechanical passes where creative judgement isn't needed.
# OPENAI_PLANNING_MODEL_CHEAP=

# Planning determinism — keep low. Creativity comes from the prompt, not sampling.
OPENAI_TEMPERATURE=0.3
# Max repair round-trips when planner output fails schema validation. Keep at 1;
# unbounded repair loops burn money silently.
PLANNER_MAX_REPAIR_ATTEMPTS=1


# -----------------------------------------------------------------------------
# fal.ai — AI image + video generation  [M7]
# -----------------------------------------------------------------------------
# Ladder rungs 5 (video) and 6 (image), both behind one key and one queue API.
# Video is the most expensive and slowest thing in the pipeline: jobs are
# submit-and-poll and can take minutes. The job handle is persisted immediately
# on submit so a crash never orphans a clip you already paid for.
# Get a key: https://fal.ai/dashboard/keys
FAL_KEY=

# DELIBERATELY UNSET. The right model for archival-documentary content is an
# empirical question, not a procurement one — settle both by rendering the M0
# fixture through candidates and comparing (M7 "Step 0 - the model bake-off").
# Judge on whether output sits convincingly beside real archival photography,
# not on standalone prettiness. Verify current availability and pricing at
# https://fal.ai/models before committing budget.
FAL_IMAGE_MODEL=
FAL_VIDEO_MODEL=

FAL_POLL_INTERVAL_SECONDS=15
FAL_MAX_POLL_MINUTES=20


# -----------------------------------------------------------------------------
# ElevenLabs — narration  [M5, M8]
# -----------------------------------------------------------------------------
# Narration is the MASTER CLOCK for the whole render (decision D1). Word-level
# timestamps from the timestamped endpoint drive shot durations, audio sync and
# caption timing — so the timestamped endpoint is required, not optional.
# Get a key: https://elevenlabs.io/app/settings/api-keys
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=
ELEVENLABS_OUTPUT_FORMAT=mp3_44100_128


# -----------------------------------------------------------------------------
# Wikimedia Commons — historical / archival search  [M6]
# -----------------------------------------------------------------------------
# Ladder rung 2. No API key, but a descriptive User-Agent with real contact
# details is REQUIRED by their terms — generic agents get blocked.
WIKIMEDIA_USER_AGENT=VideoGenerationEngine/0.1 (https://example.com; you@example.com)
WIKIMEDIA_API_URL=https://commons.wikimedia.org/w/api.php
WIKIMEDIA_RATE_LIMIT_PER_SECOND=5


# -----------------------------------------------------------------------------
# Pexels — stock imagery and footage  [M6]
# -----------------------------------------------------------------------------
# Ladder rung 4. Free tier is generous. Get a key: https://www.pexels.com/api/
PEXELS_API_KEY=


# -----------------------------------------------------------------------------
# Music  [M8]
# -----------------------------------------------------------------------------
# Background score, mixed under narration with automatic ducking.
#
# NOTE: Epidemic Sound's API is partner-gated and Artlist has no public API.
# v1 ships against Pixabay Music (free, no attribution required); the
# MusicProvider interface lets a licensed library drop in unchanged later.
MUSIC_PROVIDER=pixabay            # pixabay | freesound | epidemic
PIXABAY_API_KEY=
# FREESOUND_API_KEY=
# EPIDEMIC_SOUND_CLIENT_ID=
# EPIDEMIC_SOUND_CLIENT_SECRET=

# Mix levels. Music sits well under the voice; ducking drops it further while
# narration is speaking.
MUSIC_BED_GAIN_DB=-22
MUSIC_DUCK_GAIN_DB=-32


# =============================================================================
# RENDERING  [M0, M8]
# =============================================================================
# Rendering must be deterministic (Invariant I5): same timeline + same assets +
# same settings + same FFmpeg version => byte-identical output. The FFmpeg
# version is pinned in Docker and recorded in the render fingerprint.
FFMPEG_BINARY=ffmpeg
FFPROBE_BINARY=ffprobe

# Vertical short-form. Do not build a general video compositor.
RENDER_WIDTH=1080
RENDER_HEIGHT=1920
RENDER_FPS=30
RENDER_PIXEL_FORMAT=yuv420p

# Fast low-res pass for iteration. Most defects (wrong asset, wrong order, bad
# pacing) are visible at any resolution.
DRAFT_WIDTH=480
DRAFT_HEIGHT=854

# Transitions OVERLAP adjacent shots rather than extending the timeline
# (decision D5) — extending would drift video away from the narration clock.
DEFAULT_TRANSITION_DURATION_S=0.4

BURN_CAPTIONS=true
CAPTION_FONT=Inter


# =============================================================================
# CREATIVE CONSTRAINTS  [M5]
# =============================================================================
# Enforced in the Shot Planner prompt AND validated on planner output. An
# unconstrained planner will emit forty 0.4-second shots and the renderer will
# produce a strobe.
MAX_VIDEO_DURATION_S=90           # decision D7
MAX_SHOTS_PER_PROJECT=40          # decision D7
MIN_SHOT_DURATION_S=1.5
MAX_SHOT_DURATION_S=8.0
MAX_SCENES=12
DEFAULT_LANGUAGE=en


# =============================================================================
# COST CONTROL  [M7]
# =============================================================================
# A retry bug against a paid video API is the most expensive failure mode this
# system has. The cap raises a permanent error and halts the run.
PROJECT_BUDGET_CAP_CENTS=1000     # $10.00 hard ceiling per project
REQUIRE_COST_ESTIMATE_BEFORE_APPROVAL=true

# Concurrency caps per provider. Parallelism is required, but unbounded fan-out
# trips rate limits and turns a cheap run into a retry storm.
MAX_CONCURRENT_IMAGE_JOBS=4
MAX_CONCURRENT_VIDEO_JOBS=2
MAX_CONCURRENT_ASSET_DOWNLOADS=8


# =============================================================================
# API  [M9]
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_PATH=/api/v1
CORS_ORIGINS=http://localhost:3000

# No authentication in v1 (decision D8, per 04_System_Architecture.md).
# Do not let the single-user assumption leak into the data model.
